POSTGRES_DB=staypilot
POSTGRES_USER=staypilot
POSTGRES_PASSWORD=replace_with_strong_database_password
DATABASE_URL=postgresql+psycopg://staypilot:replace_with_strong_database_password@postgres:5432/staypilot

SECRET_KEY=replace_with_64_plus_random_chars
CORS_ORIGINS=https://your-domain.example
NEXT_PUBLIC_API_URL=https://api.your-domain.example
BACKEND_PORT=8000
FRONTEND_PORT=3000

AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
CSRF_ENFORCE=true
CSRF_TRUSTED_ORIGINS=https://your-domain.example

PAYMENT_WEBHOOK_SECRET=replace_with_payment_webhook_hmac_secret

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_TELEGRAM_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_METRICS_WINDOW_MINUTES=60
OBSERVABILITY_ALERT_PAYMENT_FAIL_RATE=0.2
OBSERVABILITY_ALERT_COMMUNICATION_FAIL_RATE=0.2
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

API_RATE_LIMIT_PER_MINUTE=300
CHAT_RATE_LIMIT_PER_MINUTE=45
